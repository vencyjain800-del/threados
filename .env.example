# ── App ──────────────────────────────────────────────
APP_ENV=development                 # development | staging | production
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://threados_app:password@localhost:5432/threados
DATABASE_MIGRATE_URL=postgresql+psycopg://threados_migrate:password@localhost:5432/threados

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth / sessions ──────────────────────────────────
SESSION_SECRET=change-me-32-byte-random-value-here
SESSION_TTL_HOURS=336
COOKIE_DOMAIN=localhost
CSRF_SECRET=change-me-32-byte-random-csrf-here

# ── Shopify ──────────────────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_inventory,read_locations,read_all_orders
SHOPIFY_APP_URL=https://<your-tunnel>.ngrok.io
SHOPIFY_REDIRECT_URI=https://<your-tunnel>.ngrok.io/shopify/callback
SHOPIFY_API_VERSION=2025-07

# ── AWS / encryption ─────────────────────────────────
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KMS_KEY_ID=
S3_BUCKET_RAW=threados-raw-dev

# ── Email ────────────────────────────────────────────
POSTMARK_SERVER_TOKEN=

# ── Observability ────────────────────────────────────
SENTRY_DSN=
